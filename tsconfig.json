{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "noImplicitReturns": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
